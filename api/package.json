{
  "name": "@mockmatch/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./router": {
      "types": "./src/trpc/index.ts",
      "default": "./src/trpc/index.ts"
    }
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "dev:ws": "tsx watch src/ws.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "start:ws": "node dist/ws.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:schema:mermaid": "tsx scripts/generate-schema-mermaid.ts",
    "db:seed:exercises": "tsx scripts/seed-practice-exercises.ts",
    "db:seed:spreadsheet-page": "tsx scripts/seed-spreadsheet-page-questions.ts",
    "db:seed:code-run": "tsx scripts/seed-code-run-questions.ts",
    "test": "npm run test:unit",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:bench": "vitest bench --config vitest.bench.config.ts --run",
    "test:bench:db": "vitest bench --config vitest.bench.db.config.ts --run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.850.0",
    "@aws-sdk/s3-request-presigner": "^3.850.0",
    "@hono/node-server": "^1.14.4",
    "@hono/trpc-server": "^0.4.2",
    "@mockmatch/schemas": "*",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "@openrouter/sdk": "^0.13.66",
    "@trpc/server": "^11.18.0",
    "ai": "^7.0.37",
    "bullmq": "^5.56.0",
    "dotenv": "^17.0.0",
    "drizzle-orm": "^0.44.2",
    "hono": "^4.8.4",
    "ioredis": "^5.6.1",
    "jose": "^6.0.11",
    "nodemailer": "^9.0.3",
    "pg": "^8.16.3",
    "pino": "^9.7.0",
    "playwright": "^1.61.1",
    "stripe": "^17.7.0",
    "unpdf": "^1.6.2",
    "ws": "^8.21.1",
    "yjs": "^13.6.31",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^11.14.0",
    "@testcontainers/redis": "^11.14.0",
    "@types/node": "^22",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.15.4",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.4",
    "pino-pretty": "^13.0.0",
    "testcontainers": "^11.14.0",
    "tsx": "^4.20.3",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
