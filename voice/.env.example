VOICE_HOST=0.0.0.0
VOICE_PORT=7860
PUBLIC_URL=http://localhost:7860
WORKER_ID=
REDIS_URL=redis://127.0.0.1:6379
# Must match API JWT_ACCESS_SECRET for ticket verification
JWT_ACCESS_SECRET=dev-access-secret-change-me-32chars
VOICE_TICKET_AUDIENCE=voice

# Flush transcripts to API
API_INTERNAL_URL=http://localhost:3000
VOICE_WORKER_SECRET=dev-voice-worker-secret-change-me

# LLM (OpenRouter)
OPENROUTER_API_KEY=
PIPECAT_LLM_MODEL=google/gemma-4-26b-a4b-it:free

# STT + TTS — Deepgram (one key for both)
DEEPGRAM_API_KEY=
# Cheapest English streaming STT (monolingual)
DEEPGRAM_STT_MODEL=nova-3

ICE_STUN_URLS=stun:stun.l.google.com:19302
ICE_TURN_URLS=
ICE_TURN_USERNAME=
ICE_TURN_CREDENTIAL=

LOG_LEVEL=info
