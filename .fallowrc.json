{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "client/src/main.tsx",
    "api/src/index.ts",
    "api/src/worker.ts",
    "api/src/ws.ts",
    "api/src/lib/s3.ts",
    "client/src/components/ui/**/*.{ts,tsx}",
    "client/src/components/shadcn-space/**/*.{ts,tsx}",
    "client/src/components/format/**/*.{ts,tsx}",
    "api/tests/**/*.{ts,tsx}",
    "client/tests/**/*.{ts,tsx}",
    "packages/*/tests/**/*.{ts,tsx}",
    "client/src/features/rich-text-demo/**/*.{ts,tsx}",
    "voice/tests/**/*.py",
    "docs/content/docs/**/*.{mdx,md}"
  ],
  "ignoreDependencies": [
    "ws",
    "testcontainers",
    "@testcontainers/postgresql",
    "@testcontainers/redis"
  ],
  "workspaces": {
    "packages": ["client", "api", "packages/*"]
  },
  "duplicates": {
    "minOccurrences": 3,
    "ignore": [
      "client/src/components/ui/**",
      "client/src/components/shadcn-space/**",
      "**/tests/**",
      "**/*.test.ts",
      "**/*.test.tsx",
      "**/*.bench.ts",
      "**/*.spec.ts"
    ]
  },
  "rules": {
    "unused-exports": "off",
    "unused-types": "off",
    "duplicate-exports": "off",
    "unused-files": "error",
    "unused-dependencies": "error"
  }
}
