{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "client/src/main.tsx",
    "api/src/index.ts",
    "api/src/worker.ts",
    "api/src/ws.ts",
    "api/src/lib/s3.ts",
    "client/src/components/ui/**/*.{ts,tsx}",
    "client/src/components/shadcn-space/**/*.{ts,tsx}",
    "client/src/components/format/**/*.{ts,tsx}"
  ],
  "workspaces": {
    "packages": ["client", "api", "packages/*"]
  },
  "duplicates": {
    // Hide pair-only clones; focus on widespread copy-paste
    // worth refactoring. Lower to 2 to report every duplicate pair.
    "minOccurrences": 3,
    "ignore": [
      "client/src/components/ui/**",
      "client/src/components/shadcn-space/**"
    ]
  },
  "rules": {
    // Public/shared surfaces intentionally export more than current callers.
    // PR gate (`fallow audit`) still flags newly introduced dead code.
    "unused-exports": "off",
    "unused-types": "off",
    "duplicate-exports": "off",
    "unused-files": "error",
    "unused-dependencies": "error"
  }
}
