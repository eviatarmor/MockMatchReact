{
  "name": "@mockmatch/document-editor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./grammar": {
      "types": "./src/lib/grammar/harper.ts",
